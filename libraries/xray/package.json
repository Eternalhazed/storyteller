{
  "name": "@storyteller/xray",
  "version": "0.1.0",
  "description": "Builds a spoiler-safe index of the characters, places, groups, and things in an EPUB",
  "author": "Shane Friedman",
  "license": "MIT",
  "keywords": [
    "epub",
    "ebook",
    "x-ray",
    "index"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/storyteller-platform/storyteller"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./epub": {
      "types": "./src/epub.ts",
      "default": "./src/epub.ts"
    },
    "./view": {
      "types": "./src/view.ts",
      "default": "./src/view.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rm -rf dist .tsbuild && tsc -b tsconfig.build.json",
    "cli": "tsx src/cli.ts",
    "prepack": "yarn build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "~1.9.0",
    "@storyteller/align": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/strictest": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./epub": {
        "types": "./dist/epub.d.ts",
        "default": "./dist/epub.js"
      },
      "./view": {
        "types": "./dist/view.d.ts",
        "default": "./dist/view.js"
      }
    }
  }
}
